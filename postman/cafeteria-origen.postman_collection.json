{
  "info": {
    "name": "Cafetería Origen API",
    "description": "Requests de la API de la Cafetería Origen (Parcial 1, TUPProIV).\n\nLevantar el server con `npm run dev` (http://localhost:3000). La variable `baseUrl` de la collection se puede cambiar si usan otro puerto.\n\nCorriendo la collection completa en orden (Run collection), el request \"Crear pedido\" guarda el id creado en la variable `pedidoId`, que usa \"Obtener pedido por id\". Cada request trae tests (pestaña Tests) que validan el status y la forma de la respuesta.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000" },
    { "key": "pedidoId", "value": "1" }
  ],
  "item": [
    {
      "name": "Health",
      "request": {
        "method": "GET",
        "url": { "raw": "{{baseUrl}}/health", "host": ["{{baseUrl}}"], "path": ["health"] }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200 OK', () => pm.response.to.have.status(200));",
              "pm.test('status ok', () => pm.expect(pm.response.json()).to.eql({ status: 'ok' }));"
            ]
          }
        }
      ]
    },
    {
      "name": "Productos",
      "item": [
        {
          "name": "Listar productos",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/productos", "host": ["{{baseUrl}}"], "path": ["productos"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const productos = pm.response.json();",
                  "pm.test('el catálogo tiene 20 productos', () => pm.expect(productos).to.have.lengthOf(20));",
                  "pm.test('cada producto tiene id, nombre, precioBase y precio', () => {",
                  "  productos.forEach(p => pm.expect(p).to.include.keys('id', 'nombre', 'precioBase', 'precio'));",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Obtener café por id (Expreso Taza grande Etiopía)",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/productos/9", "host": ["{{baseUrl}}"], "path": ["productos", "9"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const p = pm.response.json();",
                  "pm.test('es el Expreso Taza grande Etiopía', () => pm.expect(p.nombre).to.eql('Expreso Taza grande Etiopía'));",
                  "pm.test('precio = 2500 + 36 g × 240 = 11140', () => pm.expect(p.precio).to.eql(11140));"
                ]
              }
            }
          ]
        },
        {
          "name": "Obtener pastelería por id (Torta selva negra)",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/productos/20", "host": ["{{baseUrl}}"], "path": ["productos", "20"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('precio = precioBase = 4200', () => pm.expect(pm.response.json().precio).to.eql(4200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Producto inexistente (404)",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/productos/999", "host": ["{{baseUrl}}"], "path": ["productos", "999"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('404 Not Found', () => pm.response.to.have.status(404));",
                  "pm.test('error NoEncontrado', () => pm.expect(pm.response.json()).to.eql({ error: 'NoEncontrado' }));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Pedidos",
      "item": [
        {
          "name": "Crear pedido",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"mesa\": 7,\n  \"items\": [\n    {\n      \"productoId\": 1,\n      \"cantidad\": 2\n    },\n    {\n      \"productoId\": 20,\n      \"cantidad\": 1\n    }\n  ]\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{baseUrl}}/pedidos", "host": ["{{baseUrl}}"], "path": ["pedidos"] },
            "description": "2 × Expreso Pocillo Brasil ($5.020) + 1 × Porción de torta selva negra ($4.200) = $14.240"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 Created', () => pm.response.to.have.status(201));",
                  "const pedido = pm.response.json();",
                  "pm.test('estado pendiente por defecto', () => pm.expect(pedido.estado).to.eql('pendiente'));",
                  "pm.test('mesa 7', () => pm.expect(pedido.mesa).to.eql(7));",
                  "pm.test('total = 5020 × 2 + 4200 = 14240', () => pm.expect(pedido.total).to.eql(14240));",
                  "pm.collectionVariables.set('pedidoId', pedido.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Crear pedido sin mesa",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"mesa\": null,\n  \"items\": [\n    {\n      \"productoId\": 14,\n      \"cantidad\": 3\n    },\n    {\n      \"productoId\": 19,\n      \"cantidad\": 2\n    }\n  ]\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{baseUrl}}/pedidos", "host": ["{{baseUrl}}"], "path": ["pedidos"] },
            "description": "3 × Filtrado Mediano Colombia ($5.900) + 2 × Muffin de chocolate ($2.500) = $22.700. El pedido nace pendiente y mesa es null."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 Created', () => pm.response.to.have.status(201));",
                  "const pedido = pm.response.json();",
                  "pm.test('estado pendiente', () => pm.expect(pedido.estado).to.eql('pendiente'));",
                  "pm.test('mesa null', () => pm.expect(pedido.mesa).to.eql(null));",
                  "pm.test('total = 5900 × 3 + 2500 × 2 = 22700', () => pm.expect(pedido.total).to.eql(22700));"
                ]
              }
            }
          ]
        },
        {
          "name": "Crear pedido inválido (400 DatosInvalidos)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"items\": [\n    { \"productoId\": 1, \"cantidad\": 0 }\n  ]\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{baseUrl}}/pedidos", "host": ["{{baseUrl}}"], "path": ["pedidos"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('400 Bad Request', () => pm.response.to.have.status(400));",
                  "pm.test('error DatosInvalidos', () => pm.expect(pm.response.json().error).to.eql('DatosInvalidos'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Crear pedido con producto inexistente (400)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"items\": [\n    { \"productoId\": 999, \"cantidad\": 1 }\n  ]\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{baseUrl}}/pedidos", "host": ["{{baseUrl}}"], "path": ["pedidos"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('400 Bad Request', () => pm.response.to.have.status(400));",
                  "pm.test('error ProductoInexistente', () => {",
                  "  pm.expect(pm.response.json()).to.eql({ error: 'ProductoInexistente', productoId: 999 });",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Listar pedidos",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/pedidos", "host": ["{{baseUrl}}"], "path": ["pedidos"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('cada pedido trae su total', () => {",
                  "  pm.response.json().forEach(p => pm.expect(p).to.include.keys('id', 'mesa', 'items', 'estado', 'total'));",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Obtener pedido por id",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/pedidos/{{pedidoId}}", "host": ["{{baseUrl}}"], "path": ["pedidos", "{{pedidoId}}"] },
            "description": "Usa la variable pedidoId, que guarda el request \"Crear pedido\"."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('es el pedido pedido', () => {",
                  "  pm.expect(String(pm.response.json().id)).to.eql(String(pm.collectionVariables.get('pedidoId')));",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Pedido inexistente (404)",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/pedidos/99999", "host": ["{{baseUrl}}"], "path": ["pedidos", "99999"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('404 Not Found', () => pm.response.to.have.status(404));",
                  "pm.test('error NoEncontrado', () => pm.expect(pm.response.json()).to.eql({ error: 'NoEncontrado' }));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Reportes",
      "item": [
        {
          "name": "Facturación total",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/reportes/facturacion", "host": ["{{baseUrl}}"], "path": ["reportes", "facturacion"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('devuelve { total: number }', () => pm.expect(pm.response.json().total).to.be.a('number'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Cantidad vendida por tipo",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/reportes/cantidades", "host": ["{{baseUrl}}"], "path": ["reportes", "cantidades"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('cada valor es una cantidad', () => {",
                  "  Object.values(pm.response.json()).forEach(c => pm.expect(c).to.be.a('number'));",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Tipo más vendido",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/reportes/mas-vendido", "host": ["{{baseUrl}}"], "path": ["reportes", "mas-vendido"] },
            "description": "Devuelve 404 { error: \"SinVentas\" } si todavía no hay pedidos."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('devuelve tipo y cantidad', () => {",
                  "  pm.expect(pm.response.json()).to.have.all.keys('tipo', 'cantidad');",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}
